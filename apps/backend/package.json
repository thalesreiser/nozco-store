{
  "name": "@nozco/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env MEDUSA_DISABLE_TELEMETRY=true medusa develop",
    "build": "cross-env MEDUSA_DISABLE_TELEMETRY=true medusa build",
    "start": "cd .medusa/server && cross-env MEDUSA_DISABLE_TELEMETRY=true medusa start",
    "start:server": "cd .medusa/server && cross-env MEDUSA_DISABLE_TELEMETRY=true MEDUSA_WORKER_MODE=server medusa start",
    "start:worker": "cd .medusa/server && cross-env MEDUSA_DISABLE_TELEMETRY=true MEDUSA_WORKER_MODE=worker medusa start",
    "db:migrate": "cross-env MEDUSA_DISABLE_TELEMETRY=true medusa db:migrate",
    "store:publishable-key": "cross-env MEDUSA_DISABLE_TELEMETRY=true medusa exec ./src/scripts/publishable-key.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:integration": "cross-env TEST_TYPE=integration NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.4",
    "@medusajs/admin-shared": "2.22.4",
    "@medusajs/caching": "2.22.4",
    "@medusajs/cli": "2.22.4",
    "@medusajs/dashboard": "2.22.4",
    "@medusajs/draft-order": "2.22.4",
    "@medusajs/framework": "2.22.4",
    "@medusajs/medusa": "2.22.4",
    "@medusajs/ui": "4.2.11",
    "@nozco/shared-types": "workspace:*",
    "@tanstack/react-query": "5.106.1",
    "ioredis": "5.11.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.4",
    "@medusajs/test-utils": "2.22.4",
    "@nozco/eslint-config": "workspace:*",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "catalog:",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "cross-env": "10.1.0",
    "eslint": "catalog:",
    "jest": "29.7.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "10.9.2",
    "typescript": "catalog:",
    "vite": "7.3.7"
  }
}
