{
  "name": "@nozco/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build",
    "start": "cd .medusa/server && medusa start",
    "start:server": "cd .medusa/server && cross-env MEDUSA_WORKER_MODE=server medusa start",
    "start:worker": "cd .medusa/server && cross-env MEDUSA_WORKER_MODE=worker medusa start",
    "db:migrate": "medusa db:migrate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:integration": "cross-env TEST_TYPE=integration NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.3",
    "@medusajs/admin-shared": "2.22.3",
    "@medusajs/caching": "2.22.3",
    "@medusajs/cli": "2.22.3",
    "@medusajs/dashboard": "2.22.3",
    "@medusajs/draft-order": "2.22.3",
    "@medusajs/framework": "2.22.3",
    "@medusajs/medusa": "2.22.3",
    "@medusajs/ui": "4.2.10",
    "@tanstack/react-query": "5.64.2",
    "ioredis": "5.11.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.3",
    "@medusajs/test-utils": "2.22.3",
    "@nozco/eslint-config": "workspace:*",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "catalog:",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "cross-env": "10.1.0",
    "eslint": "catalog:",
    "jest": "29.7.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "10.9.2",
    "typescript": "catalog:",
    "vite": "7.3.7"
  }
}
