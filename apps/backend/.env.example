# Copy to .env for local development. Never commit .env.
# `src/lib/env.ts` validates these at startup; the error names each invalid variable.
# `medusa start` defaults NODE_ENV to production, where the variables marked below are required.

# PostgreSQL 15. Required in production. This local value matches the defaults of
# infra/docker-compose.yml; without Docker, point it at your own server.
DATABASE_URL=postgres://nozco:nozco_local@127.0.0.1:5432/nozco

# Redis 7. Required by worker mode, and a server that has a worker must use the same one. When
# empty, Medusa uses its in-memory modules, which only work for a single process.
# With infra/docker-compose.yml: redis://127.0.0.1:6379
REDIS_URL=

# shared (default): one process does everything. server: API and admin only. worker: subscribers
# and scheduled jobs only.
MEDUSA_WORKER_MODE=shared

# Comma-separated origins. Required in production; these local values are also the defaults.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Required in production, at least 32 characters each (e.g. `openssl rand -base64 48`).
JWT_SECRET=
COOKIE_SECRET=

# Medusa telemetry stays off. The package.json scripts already set this; a deploy that calls the
# medusa CLI directly must set it too.
MEDUSA_DISABLE_TELEMETRY=true
