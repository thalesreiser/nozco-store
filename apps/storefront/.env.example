# Copy to .env. Placeholders only: never put real values in this file.
# The server refuses to start if any of these is missing or invalid.

# Base URL of the Medusa API.
NUXT_PUBLIC_API_URL=http://localhost:9000
# Medusa publishable key.
NUXT_PUBLIC_PUBLISHABLE_KEY=pk_placeholder
# development | preview | production
NUXT_PUBLIC_APP_ENV=development
# mock | api. Components never see the difference. Read at build time too: the fictional fixtures enter
# the bundle only when this is mock and NUXT_PUBLIC_APP_ENV is development or preview. Production refuses
# mock, both when building and when the server starts.
NUXT_PUBLIC_DATA_SOURCE=mock

# Store details. Real values never go in this repository. A missing one hides its element.
# WhatsApp number: digits only, with the country code. Without it the fixed button stays out.
# NUXT_PUBLIC_WHATSAPP_NUMBER=5500000000000
# Legal data shown in the footer (RST-01, Q-11). Required when NUXT_PUBLIC_APP_ENV=production: the server
# refuses to start without all four. Development and preview run without them.
# NUXT_PUBLIC_LEGAL_NAME=[Razão social]
# NUXT_PUBLIC_CNPJ=00.000.000/0000-00
# NUXT_PUBLIC_LEGAL_ADDRESS=[Endereço]
# NUXT_PUBLIC_CONTACT_EMAIL=contato@example.com
# Name|https://url entries separated by commas. Only https is accepted.
# NUXT_PUBLIC_SOCIAL_LINKS=Rede|https://example.com/rede
# Names separated by commas, shown as text.
# NUXT_PUBLIC_PAYMENT_METHODS=[Forma de pagamento]
