# Optional: copy to infra/.env to override the defaults in docker-compose.yml. Never commit .env.
# Local-only values. If you change them, change DATABASE_URL and REDIS_URL in apps/backend/.env too.
# Keep the password URL-safe, since it goes into DATABASE_URL. Postgres applies the user, password and
# database only when its volume is first created.

POSTGRES_USER=nozco
POSTGRES_PASSWORD=nozco_local
POSTGRES_DB=nozco
POSTGRES_PORT=5432
REDIS_PORT=6379
